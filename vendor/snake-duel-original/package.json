{
  "name": "snake-duel",
  "version": "1.0.0",
  "description": "Two-player multiplayer Snake game over WebSocket with game rooms",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json && node scripts/fix-client-esm-extensions.js",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "dev": "npm run build && npm run start"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4"
  }
}
